#!/bin/sh
# A minimal fake Slurm for tests/snapshots.rs: scontrol, squeue, sacct, ... are symlinks to
# this script. It answers from recorded fixtures listed in ./index (format described there),
# logs every call to $FAKE_SLURM_LOG and fails closed on calls it does not know.
call="${0##*/} $*"
while read -r scenario code file pattern; do
    case $scenario in '#'* | '') continue ;; esac
    # shellcheck disable=SC2254 # globs on purpose
    case $FAKE_SLURM_SCENARIO in $scenario) ;; *) continue ;; esac
    # shellcheck disable=SC2254
    case $call in $pattern) ;; *) continue ;; esac
    printf '%s\n' "$call" >>"$FAKE_SLURM_LOG"
    answer=$FAKE_SLURM_DIR/$file
    if [ -f "$answer" ]; then sed "s|@TMP@|$FAKE_SLURM_TMP|g" "$answer"; fi
    if [ -f "$answer.err" ]; then cat "$answer.err" >&2; fi
    exit "$code"
done <"$FAKE_SLURM_DIR/index"
printf 'unexpected: %s\n' "$call" >>"$FAKE_SLURM_LOG"
printf 'fake slurm: unexpected call: %s\n' "$call" >&2
exit 1
